# Local paths are relative to this repository.
DATA_DIR=data/batch_a
QUARANTINE_DIR=data/quarantine
ARCHIVE_DIR=data/archive
TRACE_DIR=traces
VECTOR_DIR=data/vector_store
COLLECTION=ragops
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
TOP_K=5
CHUNK_SIZE=220
CHUNK_OVERLAP=40
SEED=4032

# Local model loading is enabled when LLM_API_KEY is empty.
LLM_DEVICE=cpu
MODEL_CACHE_OFFLINE=1
